; QOSRequested=%PRECEDENCE%,%DELAY%,%RELIABILITY%,%PEAK%,%MEAN%
; QOSMinimum=%PRECEDENCE%,%DELAY%,%RELIABILITY%,%PEAK%,%MEAN%
;   where :
;    %PRECEDENCE% = 0-3 with 0 (Subscribed), 1 (High), 2 (Normal), 3 (Low)
;    %DELAY% = 0-4 with 0 (Subscribed), 4 (Best effort)
;    %RELIABILITY% = 0-5 with 0 (Subscribed)
;                             1 (Acknowledged GTP, LLC, RLC; Protected data)
;                             2 (Unacknowledged GTP; Acknowledged LLC, RLC; Protected data)
;                             3 (Unacknowledged GTP, LLC, RLC; Protected data)
;                             4 (Unacknowledged GTP, LLC; Acknowledged RLC; Protected data)
;                             5 (Unacknowledged GTP, LLC, RLC; Unprotected data)
;    %PEAK% = 0 - 9 with 0 (Subscribed)
;                        1 Up to 1 000 bytes/s
;                        2 Up to 2 000 bytes/s
;                        3 Up to 4 000 bytes/s
;                        4 Up to 8 000 bytes/s
;                        5 Up to 16 000 bytes/s
;                        6 Up to 32 000 bytes/s
;                        7 Up to 64 000 bytes/s
;                        8 Up to 128 000 bytes/s
;                        9 Up to 256 000 bytes/s
;   %MEAN% = 0 - 31 with 0 (Subscribed)
;                        1 - 100 bytes/h
;                        2 - 200 bytes/h
;                        3 - 500 bytes/h
;                        4 - 1 000 bytes/h
;                        5 - 2 000 bytes/h
;                        6 - 5 000 bytes/h
;                        7 - 10 000 bytes/h
;                        8 - 20 000 bytes/h
;                        9 - 50 000 bytes/h
;                        10 - 100 000 bytes/h
;                        11 - 200 000 bytes/h
;                        12 - 500 000 bytes/h
;                        13 - 1 000 000 bytes/h
;                        14 - 2 000 000 bytes/h
;                        15 - 5 000 000 bytes/h
;                        16 - 10 000 000 bytes/h
;                        17 - 20 000 000 bytes/h
;                        18 - 50 000 000 bytes/h
;                        31 - Best effort

