[Version]
Signature="$CHICAGO$"
Class=Modem
ClassGUID={4D36E96D-E325-11CE-BFC1-08002BE10318}
Provider=%Motorola%
LayoutFile=layout.inf
DriverVer=4/5/2004, 2.0.0.4

[Manufacturer]
%Motorola% = Motorola

[Motorola]
