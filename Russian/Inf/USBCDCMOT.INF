%USBTALONINT%		=USBTALONINT,USB\VID_22B8&PID_6102
%USBHELEN%		=USBHELEN,USB\VID_22B8&PID_4002
%USBEZX%		=USBEZX,USB\VID_22B8&PID_6002
%USBNEPTUNEULS%         =USBNEPTUNEULS,USB\VID_22B8&PID_5802
%USBNEPTUNELTS%		=USBNEPTUNELTS,USB\VID_22B8&PID_4802
%USBNEPTUNELTE%		=USBNEPTUNELTE,USB\VID_22B8&PID_4902
%USBNEPTUNELTX%		=USBNEPTUNELTX,USB\VID_22B8&PID_4A02
%USBQUALCOMM6050%	=USBQUALCOMM6050,USB\VID_22B8&PID_2A02
%USBMSM6100%    	=USBMSM6100,USB\VID_22B8&PID_2A22
%USBMSM6300%    	=USBMSM6300,USB\VID_22B8&PID_2A42

[USBCDMA]
