[Version]
CatalogFile=usbcdc.cat
Signature="$CHICAGO$"
Class=USB
Provider=%Motorola%
LayoutFile=layout.inf,layout1.inf,layout2.inf
DriverVer=2/3/2004, 2.0.0.3

[Manufacturer]
%Motorola%=Motorola

[Motorola]
%USBCDMA%		=USBCDMA,USB\VID_22B8&PID_0005
%USBPATRIOT%		=USBPATRIOT,USB\VID_22B8&PID_1005
%USBLCA%		=USBLCA,USB\VID_22B8&PID_3802
%USB1XCDMA%		=USB1XCDMA,USB\VID_22B8&PID_2805
%USB1XCDMA5100%		=USB1XCDMA5100,USB\VID_22B8&PID_2822
