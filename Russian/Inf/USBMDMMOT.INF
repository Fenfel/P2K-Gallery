; Revision History :
;
; LIBdd18138 - PID change for Talon Int.
; LIBdd25316 - Support for Qualcomm 6050 chipset
; LIBdd73554   2-3-2004  Support for QualComm 6100 and 6300 chipsets

[Version]
CatalogFile=mdmluc.cat
LayoutFile=layout.inf,layout1.inf,layout2.inf
Signature="$CHICAGO$"
Class=Modem
Provider=%Motorola%
CLASSGUID={4D36E96D-E325-11CE-BFC1-08002BE10318}
DriverVer=2/3/2004, 2.0.0.3

[Manufacturer]
%Motorola%=Motorola

[Motorola]
%USBCDMA%    		= USBCDMA,    USB\MOTUSBCDMA
%USBPATRIOT% 		= USBPATRIOT, USB\MOTUSBPATRIOT
%USBLCA% 		= USBLCA,  USB\MOTUSBLCA
%USB1XCDMA%		= USB1XCDMA,  USB\MOTUSB1XCDMA
%USB1XCDMA5100% 	= USB1XCDMA5100,  USB\MOTUSB1XCDMA5100
%USBTALON% 		= USBTALON,  USB\MOTUSBTALON
%USBTALONINT% 		= USBTALONINT,  USB\MOTUSBTALONINT
%USBHELEN%		= USBHELEN,  USB\MOTUSBHELEN
%USBNEPTUNEULS%		= USBNEPTUNEULS, USB\MOTUSBNEPTUNEULS
%USBNEPTUNELTS%		= USBNEPTUNELTS, USB\MOTUSBNEPTUNELTS
%USBEZX%		= USBEZX, USB\MOTUSBEZX
%USBNEPTUNELTE%		= USBNEPTUNELTE, USB\MOTUSBNEPTUNELTE
%USBNEPTUNELTX%		= USBNEPTUNELTX, USB\MOTUSBNEPTUNELTX
%USBQUALCOMM6050%	= USBQUALCOMM6050, USB\MOTUSBQUALCOMM6050
%USBMSM6100%            = USBMSM6100,USB\MOTUSBMSM6100
%USBMSM6300%            = USBMSM6300,USB\MOTUSBMSM6300

[USBCDMA]
AddReg = All, MDMsettings, MDMresponses, CDMAspecific

[USBPATRIOT]
AddReg = All, MDMsettings, MDMresponses

[USBLCA]
AddReg = All, MDMsettings, MDMresponses

[USB1XCDMA]
AddReg = All, MDMsettings, MDMresponses

[USB1XCDMA5100]
AddReg = All, MDMsettings, MDMresponses

[USBTALON]
AddReg = All, MDMsettings, MDMresponses

[USBTALONINT]
AddReg = All, MDMsettings, MDMresponses

[USBHELEN]
AddReg = All, MDMsettings, MDMresponses

[USBNEPTUNEULS]
AddReg = All, MDMsettings, MDMresponses

[USBNEPTUNELTS]
AddReg = All, MDMsettings, MDMresponses

[USBEZX]
AddReg = All, MDMsettings, MDMresponses

[USBNEPTUNELTE]
AddReg = All, MDMsettings, MDMresponses

[USBNEPTUNELTX]
AddReg = All, MDMsettings, MDMresponses

[USBQUALCOMM6050]
AddReg = All, MDMsettings, MDMresponses

[USBMSM6100]
AddReg = All, MDMsettings, MDMresponses

[USBMSM6300]
AddReg = All, MDMsettings, MDMresponses

[All]
HKR,,FriendlyDriver,,unimodem.vxd
HKR,,DevLoader,,*vcomm
HKR,,ConfigDialog,,modemui.dll
HKR,,EnumPropPages,,"modemui.dll,EnumPropPages"
HKR,,PortSubClass,1,02
HKR,,DeviceType,1,01
HKR,,PortDriver,,wdmmdmld.vxd
HKR,,Contention,,

[MDMsettings]
HKR,, Properties, 1, 08,01,00,00, FF,00,00,00, FF,00,00,00, 07,00,00,00, 0F,00,00,00, F7,03,00,00, 00,C2,01,00, C0,DA,00,00
HKR,, InactivityScale, 1, 3c,00,00,00
HKR, Init,      1,, "ATZ<cr>" 
HKR, Init,      2,, "ATE1V1&D2<cr>"
HKR, Answer,    1,, "ATA<cr>"
HKR, Hangup,    1,, "ATHE1<cr>"
HKR,, Reset,, "ATZ<cr>"   
HKR, Settings, Prefix,, "AT"
HKR, Settings, Terminator,, "<cr>"
HKR, Settings, DialPrefix,, "D"
HKR, Settings, DialSuffix,, ""
HKR, Settings, Tone,, "T"
HKR, Monitor, 1,, "ATS0=0<cr>"
HKR, Monitor, 2,, "None"
HKR, Settings, FlowControl_Off,,  "+IFC=0,0"
HKR, Settings, FlowControl_Hard,, "+IFC=2,2"
HKR, Settings, FlowControl_Soft,, "+IFC=1,1"

[MDMresponses]
HKR, Responses, "0<cr>",  1, 00, 00, 00,00,00,00, 00,00,00,00 ; OK - Command executed
HKR, Responses, "1<cr>",  1, 02, 00, 00,00,00,00, 00,00,00,00 ; CONNECT - Connection
HKR, Responses, "2<cr>",  1, 08, 00, 00,00,00,00, 00,00,00,00 ; RING - Ring signal indicated
HKR, Responses, "3<cr>",  1, 04, 00, 00,00,00,00, 00,00,00,00 ; NO CARRIER 
HKR, Responses, "4<cr>",  1, 03, 00, 00,00,00,00, 00,00,00,00 ; ERROR - Invalid command
HKR, Responses, "6<cr>",  1, 05, 00, 00,00,00,00, 00,00,00,00 ; NO DIALTONE - No dial tone detected
HKR, Responses, "7<cr>",  1, 06, 00, 00,00,00,00, 00,00,00,00 ; BUSY - Engaged (busy) signal
HKR, Responses, "8<cr>",  1, 07, 00, 00,00,00,00, 00,00,00,00 ; NO ANSWER
HKR, Responses, "<cr><lf>OK<cr><lf>",                1, 00, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>RING<cr><lf>",              1, 08, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>ERROR<cr><lf>",             1, 03, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>NO DIALTONE<cr><lf>",       1, 05, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>NO DIAL TONE<cr><lf>",      1, 05, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>BUSY<cr><lf>",              1, 06, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>NO CARRIER<cr><lf>",        1, 04, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>NO ANSWER<cr><lf>",         1, 07, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>CONNECT<cr><lf>",           1, 02, 00, 00,00,00,00, 00,00,00,00
HKR, Responses, "<cr><lf>CONNECT 300<cr><lf>",       1, 02, 00, 2C,01,00,00, 00,00,00,00
